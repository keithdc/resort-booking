NEXT_PUBLIC_API_URL=http://localhost:3002

# Map basemap (optional). Default: OpenFreeMap "liberty", a soft-colour vector style (for a paler look set NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron), free and no key.
# A full style.json URL (MapTiler, Protomaps, self-hosted...) wins over the key below.
# NEXT_PUBLIC_MAP_STYLE_URL=
# A MapTiler key switches to MapTiler's light "dataviz-light" style.
# NEXT_PUBLIC_MAPTILER_KEY=

# Content-Security-Policy (set in src/middleware.ts). Optional.
# CSP_REPORT_ONLY=true reports violations in the browser console without blocking: use it to trial a change.
# CSP_REPORT_ONLY=true
# Extra hosts the browser may call (a self-hosted map style or tile server), space or comma separated origins.
# CSP_EXTRA_CONNECT_ORIGINS=https://tiles.example.org
