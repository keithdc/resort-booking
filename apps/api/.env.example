# Copy this file to `.env` (the API reads ONLY `.env`, never this example) and fill in real values.
# Strict by default (docs/13 R2-04): ONLY NODE_ENV=development or NODE_ENV=test switches development conveniences on
# (mock payments, open sign-up, the development 2FA key, unsalted hashes, localhost CORS). Anything else is treated
# as production: unset, "staging", "prod", a typo. The API then REFUSES TO START until every production setting is
# right. On a server set NODE_ENV=production. `npm run start:dev` sets NODE_ENV=development itself.
NODE_ENV=development

# Database. In development ONE URL (the Docker admin role) is enough: the API warns that it is a superuser.
# In production use two least-privilege roles (docs/11-database-access.md, set up with `npm run db:setup-roles`):
#   DATABASE_URL            the role the API uses at run time: resort_app (reads and writes rows, no DDL)
#   MIGRATION_DATABASE_URL  the owner role, used ONLY by `npm run migrate` (and by start-up migrations if you turn them on)
DATABASE_URL=postgres://resort:resort@localhost:5433/resort_booking
# MIGRATION_DATABASE_URL=postgres://resort_owner:<password>@localhost:5433/resort_booking
# Apply pending migrations when the API starts. Default: yes in development, NEVER in production (run `npm run migrate`).
# RUN_MIGRATIONS_ON_START=true
# Connection pool and TLS (defaults shown). DATABASE_SSL=true encrypts and verifies the certificate; a database on
# another machine must use TLS in production (or put sslmode=require in the URLs). "no-verify" skips verification.
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_SSL=true
# Only for `npm run db:setup-roles` and `npm run db:verify-roles` (never needed by the running API):
# DATABASE_ADMIN_URL=postgres://resort:resort@localhost:5433/resort_booking
# DB_OWNER_PASSWORD=
# DB_APP_PASSWORD=
# DB_READONLY_PASSWORD=
# READONLY_DATABASE_URL=postgres://resort_readonly:<password>@localhost:5433/resort_booking
# Role names (defaults shown):
# DB_OWNER_ROLE=resort_owner
# DB_APP_ROLE=resort_app
# DB_READONLY_ROLE=resort_readonly
# With a Redis password (see docker-compose.yml): REDIS_URL=redis://:<password>@localhost:6380
REDIS_URL=redis://localhost:6380
PORT=3002

# The exact origins of the guest and admin sites. In production: https only, no localhost, never "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# First start ONLY: the owner account is created from these. There is no fallback password. Choose your own;
# the values below are the development login written in the README, and the API refuses to start in production
# while an account still accepts that exact password.
STAFF_OWNER_EMAIL=owner@atlantic.example
STAFF_OWNER_PASSWORD=AtlanticOwner1!

# Payments: "mock" until the client picks a provider. The mock needs BOTH NODE_ENV=development|test AND the explicit
# opt-in below. With the mock on, POST /payments/:id/mock/complete lets anyone confirm a stay without paying, so the
# API refuses to start when ALLOW_MOCK_PAYMENTS=true is set on any production-like run. Never set it on a server.
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=true

# Payment webhooks (docs/14-payments-operations.md). POST /payments/webhooks/<provider> answers 404 until the secret is
# set. REQUIRED (16+ random characters, the signing secret the provider gives you) when a real provider is configured.
# Rotation: put the new secret in PAYMENT_WEBHOOK_SECRET and the old one in PAYMENT_WEBHOOK_SECRET_PREVIOUS, switch the
# provider over, then remove the previous one. Never log or commit either.
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_WEBHOOK_SECRET_PREVIOUS=
# How far a signed timestamp may be from now (replay protection), seconds. Default 300.
# PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Rate limit per IP on the webhook route (defaults 300 per 60 s): PAYMENT_WEBHOOK_LIMIT, PAYMENT_WEBHOOK_WINDOW_SECONDS

# Refunds: provider timeout, processing lease and the reconciler that settles refunds stuck "pending" (docs/14).
# REFUND_PROVIDER_TIMEOUT_MS=20000
# REFUND_LEASE_SECONDS=150
# REFUND_RECONCILER_ENABLED=true
# REFUND_RECONCILE_AFTER_MINUTES=10
# REFUND_RECONCILE_MAX_ATTEMPTS=5
# REFUND_RECONCILE_BATCH=20

# Open sign-up of new workspaces. Unset: open in development, closed everywhere else. In production leave it unset or false.
ALLOW_REGISTRATION=true

# Behind a reverse proxy or CDN: the number of proxy hops in front of the API (usually 1). Leave unset when the
# API is reached directly. Wrong values let a caller spoof their IP with X-Forwarded-For and dodge rate limits.
# TRUST_PROXY=1

# Secret salt for the one-way hashes of IPs and emails kept for abuse limits and the audit log. REQUIRED (32+ random
# characters, for example `openssl rand -hex 32`) everywhere except NODE_ENV=development|test, where leaving it out
# keeps hashing with an empty salt. Rotating it changes every hash: audit rows written before the change can no longer
# be matched to an IP seen after it (keep the old value if that matters). Never put it in git.
# IP_HASH_SALT=

# Optional two-factor sign-in (TOTP). The secrets are stored AES-256-GCM encrypted with this key: 32 random bytes as
# 64 hex characters (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# REQUIRED in production (the API refuses to start without it). In development a fixed built-in key is used with a
# warning. Keep it out of the database and backups; LOSING OR CHANGING IT makes every enrolled secret unreadable
# (staff then need an admin to reset their two-factor).
# TWO_FACTOR_ENCRYPTION_KEY=
# Wrong second-factor codes allowed per person / per IP within the window (defaults shown), then 429 with Retry-After.
# TWO_FACTOR_MAX_FAILURES_PER_USER=5
# TWO_FACTOR_MAX_FAILURES_PER_IP=20
# TWO_FACTOR_LOCK_WINDOW_SECONDS=900

# Abuse limits (all optional; defaults shown). A missing or invalid value keeps the default, never turns a limit off.
# Staff sign-in: failed attempts allowed per email / per IP within the window, then 429 with Retry-After.
# LOGIN_MAX_FAILURES_PER_EMAIL=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_LOCK_WINDOW_SECONDS=900
# Holds: requests per IP / per email in a window, and unpaid holds one email / IP may keep open at once.
# HOLD_IP_LIMIT=10
# HOLD_IP_WINDOW_SECONDS=600
# HOLD_EMAIL_LIMIT=6
# HOLD_EMAIL_WINDOW_SECONDS=600
# MAX_ACTIVE_HOLDS_PER_EMAIL=3
# MAX_ACTIVE_HOLDS_PER_IP=5
# Guest booking lookup, cancel, change dates: per IP, and per booking reference across everyone.
# BOOKING_LOOKUP_LIMIT=10
# BOOKING_LOOKUP_WINDOW_SECONDS=60
# BOOKING_REFERENCE_LIMIT=15
# BOOKING_REFERENCE_WINDOW_SECONDS=600
# Promo code attempts and search/quote/availability requests per IP.
# PROMO_LIMIT=20
# PROMO_WINDOW_SECONDS=60
# BROWSE_LIMIT=120
# BROWSE_WINDOW_SECONDS=60

# --- Staff registration, team and audit ---
# May a new workspace (organization + its first admin) be registered through POST /staff/register?
# Unset: allowed while developing, NOT allowed when NODE_ENV=production. Set "true" only on a server that should
# offer sign-up; the endpoint is rate limited either way.
# ALLOW_REGISTRATION=false
# How long a team invitation (or access-reset) link stays valid, in hours (1-720, default 72).
# INVITE_TTL_HOURS=72
# Public team endpoints, per IP unless noted (defaults shown): sign-ups an hour, sign-ups per email, invitation
# accept attempts, invitation previews. A missing or invalid value keeps the default.
# REGISTRATION_LIMIT=5
# REGISTRATION_WINDOW_SECONDS=3600
# REGISTRATION_EMAIL_LIMIT=3
# REGISTRATION_EMAIL_WINDOW_SECONDS=3600
# INVITE_ACCEPT_LIMIT=20
# INVITE_ACCEPT_WINDOW_SECONDS=3600
# INVITE_PREVIEW_LIMIT=60
# INVITE_PREVIEW_WINDOW_SECONDS=600

# --- Email (Resend) for invitation and access-reset links: optional ---
# Without RESEND_API_KEY nothing is emailed: the admin screen hides the email option and the admin copies the
# one-time link and sends it themselves. See docs/12-email.md for the setup (domain, SPF/DKIM, sending-only key).
# NEVER commit a real key: put it in apps/api/.env only (untracked).
# RESEND_API_KEY=
# Sender shown to recipients, on a domain verified in Resend. Required when RESEND_API_KEY is set.
# MAIL_FROM="Humphreys <staff@your-domain.example>"
# Address of the admin site, used to build the link in the email (<ADMIN_APP_URL>/invite/<token>). Required when
# RESEND_API_KEY is set; must be https in production.
# ADMIN_APP_URL=http://localhost:3001
# Emails per hour (defaults shown): per workspace, and per recipient address (stops spamming one person).
# When the limit is hit or Redis is down the email is skipped ("could not send") and the link can still be copied.
# INVITE_EMAIL_ORG_LIMIT=30
# INVITE_EMAIL_ORG_WINDOW_SECONDS=3600
# INVITE_EMAIL_RECIPIENT_LIMIT=4
# INVITE_EMAIL_RECIPIENT_WINDOW_SECONDS=3600

